{
  "schemaVersion": 1,
  "id": "voice_music",
  "version": "${version}",
  "name": "Voice Music",
  "description": "Group music streaming through Simple Voice Chat.",
  "environment": "server",
  "entrypoints": {
    "main": ["dev.arena.voicemusic.fabric.VoiceMusicFabric"],
    "voicechat": ["dev.arena.voicemusic.fabric.FabricVoicePlugin"]
  },
  "depends": {
    "fabricloader": "${loader_dependency}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25",
    "fabric-api": "*",
    "voicechat": "*",
    "voicechat_api": "*"
  }
}
